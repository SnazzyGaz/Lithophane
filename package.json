{
  "name": "relief-forge-litho",
  "version": "0.6.7",
  "productName": "Relief Forge Litho",
  "description": "Turn a picture into a lithophane you can 3D print.",
  "private": true,
  "license": "UNLICENSED",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:linux": "electron-builder --linux AppImage --x64 --publish never",
    "test": "node scripts/check-geometry.mjs"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.reliefforge.litho",
    "productName": "Relief Forge Litho",
    "directories": {
      "output": "dist"
    },
    "icon": "build/icon.png",
    "files": [
      "electron/**",
      "index.html",
      "samples/**",
      "build/icon.png",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "signAndEditExecutable": false,
      "artifactName": "Relief-Forge-Litho-${version}-Windows-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Relief-Forge-Litho-${version}-Windows-portable.exe",
      "unpackDirName": "ReliefForgeLitho"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Relief-Forge-Litho-${version}-Windows-setup.exe",
      "shortcutName": "Relief Forge Litho",
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics",
      "artifactName": "Relief-Forge-Litho-${version}-Linux-${arch}.${ext}"
    }
  }
}
